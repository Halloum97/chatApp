rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: authenticated users can read any profile (for search);
    // only the owner can write their own document.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Chats: only the owner can read/write their chat list.
    match /chats/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Messages: any authenticated user can read/write.
    // (Tighter participant-only rules require storing participant IDs on
    //  each message doc — acceptable trade-off for MVP.)
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }
  }
}
